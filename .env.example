# ローカル開発用の例。Neon / Supabase を使う場合は接続文字列をそのまま貼り付ける
DATABASE_URL=postgres://app:app@localhost:5432/tsuyaku

# Supabase（project ref: swzlnzjkcxsctablyeaa）の場合:
# ダッシュボード → Connect → 「Transaction pooler」の接続文字列をコピーし、
# [YOUR-PASSWORD] をデータベースのパスワードに置き換える（アカウントのログインパスワードではない）
# DATABASE_URL=postgresql://postgres.swzlnzjkcxsctablyeaa:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
